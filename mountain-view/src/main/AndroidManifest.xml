<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <application>
        <activity android:name="com.peaknav.views.AndroidLauncher" android:exported="false"
            android:process=":mountain_view" android:label="@string/mv_app_name" android:theme="@style/mv_GdxTheme"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:launchMode="singleTask" android:taskAffinity="${applicationId}.mountain_view" />
        <provider android:name="com.peaknav.views.MountainFileProvider"
            android:authorities="${applicationId}.mountains.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/mv_file_paths" />
        </provider>
        <service android:name="com.peaknav.compatibility.MapDataDownloadService" android:process=":mountain_view" android:exported="false" android:foregroundServiceType="dataSync" />
    </application>
</manifest>
